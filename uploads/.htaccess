# Bloquear ejecucion de cualquier script en la carpeta de subidas
php_flag engine off

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|asp|aspx|sh|exe)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes

# Forzar descarga en lugar de ejecutar (defensa extra)
<FilesMatch "\.(html|htm|svg|xml)$">
    ForceType text/plain
</FilesMatch>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'"
</IfModule>
